# Copy to .env and set your tokens/keys.
# Create a Hugging Face token at https://huggingface.co/settings/tokens
HF_TOKEN=

# OpenAI — required for document Q&A, CUA demo, and browser-use with ChatOpenAI
# Get a key at https://platform.openai.com/account/api-keys
OPENAI_API_KEY=

# Browser Use Cloud (optional) — for cloud-hosted browser sessions
# Get a key at https://cloud.browser-use.com/new-api-key
BROWSER_USE_API_KEY=

# Anthropic (optional) — alternative LLM for browser-use agents
ANTHROPIC_API_KEY=

# Google Gemini (optional) — alternative LLM for browser-use agents
GOOGLE_API_KEY=
